{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.fthdgn.pocket-shelf",
  "name": "pocket-shelf",
  "title": "Pocket Shelf",
  "version": "0.13.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "input.analog.left"
      ]
    }
  },
  "app": {
    "entry": "src/main.tsx",
    "output": "pocket-shelf",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          480,
          272
        ],
        "presentation": "integer-fit"
      }
    }
  }
}
